<?xml version="1.0" encoding="utf-8"?>
<!--
    A gradient rather than the flat blue square this had before, which read as a placeholder
    because it was one. Drawn edge to edge: an adaptive icon's background is cropped to whatever
    shape the launcher uses, so it must have no border of its own.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1B3FA0"
                android:centerColor="#FF2C6BE8"
                android:endColor="#FF4C9BFF" />
        </aapt:attr>
    </path>
</vector>
