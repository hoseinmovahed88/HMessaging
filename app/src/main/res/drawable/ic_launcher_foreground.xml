<?xml version="1.0" encoding="utf-8"?>
<!--
    A message bubble with the app's initial cut out of it.

    One shape, drawn as a single path with an even-odd fill so the H is a hole rather than a second
    colour: that is what lets the same drawable serve as the monochrome icon a themed launcher
    tints, and as the notification silhouette, without a separate asset for each.

    Sized to sit inside the 72dp safe zone of the 108dp adaptive canvas — anything outside it can
    be cropped away by a launcher's mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,20 L68,20 A18,18 0 0 1 86,38 L86,52 A18,18 0 0 1 68,70 L52,70 L30,88 L38,70 A18,18 0 0 1 22,52 L22,38 A18,18 0 0 1 40,20 Z M38,31 L46,31 L46,40 L62,40 L62,31 L70,31 L70,59 L62,59 L62,48 L46,48 L46,59 L38,59 Z" />
</vector>
